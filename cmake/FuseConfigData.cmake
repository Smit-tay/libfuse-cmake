# A small equivalent of meson's configuration_data() + configure_file(output:)
#
# meson writes a header from a configuration_data object like this:
#   - keys are emitted in sorted order, separated by blank lines
#   - a boolean true  becomes  "#define KEY"
#   - a boolean false becomes  "#undef KEY"
#   - a string/int    becomes  "#define KEY value"   (set_quoted adds "")
#   - a key that was never set is not emitted at all
#
# The last point matters: test/lib/checks.py decides io_uring support with
# `'HAVE_URING' not in fuse_config.h`, so CMake's "/* #undef HAVE_URING */"
# would wrongly report it as built. Producing the exact meson format also
# means the CMake and meson headers can be compared with a plain diff.

# fuse_cfg_set_bool(<cfg> <key> <condition...>)
# The condition is evaluated like if(), so a variable name or an expression.
function(fuse_cfg_set_bool cfg key)
    if(${ARGN})
        set(_line "#define ${key}")
    else()
        set(_line "#undef ${key}")
    endif()
    set_property(GLOBAL APPEND PROPERTY FUSE_CFG_${cfg}_KEYS ${key})
    set_property(GLOBAL PROPERTY FUSE_CFG_${cfg}_${key} "${_line}")
endfunction()

# fuse_cfg_set(<cfg> <key> <value>)          -> #define KEY value
function(fuse_cfg_set cfg key value)
    set_property(GLOBAL APPEND PROPERTY FUSE_CFG_${cfg}_KEYS ${key})
    set_property(GLOBAL PROPERTY FUSE_CFG_${cfg}_${key} "#define ${key} ${value}")
endfunction()

# fuse_cfg_set_quoted(<cfg> <key> <value>)   -> #define KEY "value"
function(fuse_cfg_set_quoted cfg key value)
    fuse_cfg_set(${cfg} ${key} "\"${value}\"")
endfunction()

# fuse_cfg_write(<cfg> <output-file>)
# Only touches the output when its content changes, so an unchanged
# reconfigure does not trigger a full rebuild.
function(fuse_cfg_write cfg output)
    get_property(_keys GLOBAL PROPERTY FUSE_CFG_${cfg}_KEYS)
    list(REMOVE_DUPLICATES _keys)
    list(SORT _keys)
    set(_content "/*\n * Autogenerated by the CMake build system.\n * Do not edit, your changes will be lost.\n */\n\n#pragma once\n\n")
    foreach(_key IN LISTS _keys)
        get_property(_line GLOBAL PROPERTY FUSE_CFG_${cfg}_${_key})
        string(APPEND _content "${_line}\n\n")
    endforeach()
    file(WRITE "${output}.tmp" "${_content}")
    configure_file("${output}.tmp" "${output}" COPYONLY)
    file(REMOVE "${output}.tmp")
endfunction()
